<ivy-module version="2.0">
  <info organisation="foo" module="bar" revision="1.0">
    <license name="Apache Software License 2.0"
             url="https://www.apache.org/licenses/LICENSE-2.0"/>
    <ivyauthor name="Apache Ant Development Team"
               url="https://ant.apache.org/"/>
    <description homepage="https://ant.apache.org/antlibs/cyclonedx/">
      Test-Project including multiple versions of the same dependency
    </description>
  </info>
  <configurations>
    <conf name="default" description="default dependencies"/>
    <conf name="empty" description="configuration including no dependencies"/>
    <conf name="a" description="configuration including ant 1.10.17 and its transitive dependencies"/>
    <conf name="b" description="configuration including only ant 1.10.17"/>
    <conf name="c" description="configuration including ant 1.10.16 and its transitive dependencies"/>
    <conf name="testIncludeConf" extends="empty,b"/>
    <conf name="testExternalConf" extends="c"/>
  </configurations>
  <dependencies>
    <dependency org="org.apache.ant" name="ant" rev="1.10.17" conf="a->default;b->master"/>
    <!-- this will be evicted by the conflict manager in configuration a and b -->
    <dependency org="org.apache.ant" name="ant" rev="1.10.15" conf="a->default;b->master"/>
    <!-- this will be evicted by b, but should still be included because of c -->
    <dependency org="org.apache.ant" name="ant" rev="1.10.16" conf="b->master;c->default"/>
    <conflict manager="latest-revision"/>
  </dependencies>
</ivy-module>
